{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Usage Tracker",
  "version": "0.4.0",
  "identifier": "com.aiusagetracker.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI 用量助手",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "center": true
      },
      {
        "label": "quick",
        "title": "AI 用量助手",
        "width": 380,
        "height": 320,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "publisher": "XSIJIE",
    "shortDescription": "Cross-platform AI usage and quota tracker",
    "longDescription": "Track AI subscription quotas and API usage for OpenCode Go, DeepSeek and Zhipu GLM from the system tray — balance, quota windows, usage charts and threshold alerts. All data stays on your device.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/XSIJIE975/ai-usage-tracker/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENBNTUxQzk0RDVGNzVCOTcKUldTWFcvZlZsQnhWeXIwRTJSRE50TllJUG9CMVd0Y3hUWGY1SHF3VzJzcDRseklnVmI0NjFmK0YK"
    }
  }
}
